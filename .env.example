# Contact form email delivery (https://resend.com — free tier is enough).
# Add these in Vercel → Project → Settings → Environment Variables. Never commit real values.
RESEND_API_KEY=
# Optional overrides
CONTACT_TO=pradnya@indostage.in
# Must be an address on a domain verified in Resend, e.g. "IndoStage Website <website@indostage.in>"
CONTACT_FROM=

# Free passes for Ravi Chary Crossing (/pass).
# DATABASE_URL is added automatically when you connect Neon Postgres: Vercel → Project → Storage.
DATABASE_URL=
# Total passes to hand out before the form closes (default 1500).
PASS_LIMIT=1500
# Password for downloading the booking list at /api/passes (any username).
PASSES_ADMIN_PASSWORD=
# Meta Pixel ID (Events Manager), so Instagram/Facebook ads can track pass bookings. Optional.
NEXT_PUBLIC_META_PIXEL_ID=
